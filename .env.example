# Copy to .env to override defaults (docker compose reads it automatically)
C360_N_CUSTOMERS=3000
C360_HISTORY_DAYS=120
SUPERSET_SECRET_KEY=replace-with-a-long-random-string

# Only needed when running the pipeline on your machine instead of in Docker:
# C360_PG_DSN=postgresql://c360:c360@localhost:5432/c360
# C360_MONGO_URI=mongodb://localhost:27017
# C360_KAFKA_BOOTSTRAP=localhost:9094
# C360_LAKE_PATH=./lake
# C360_RUN_DATE=2026-11-08
